# deploy/env.sh.example — copy to deploy/env.sh on the VM and fill in <project>/<APP_PORT>.
# systemd loads this via EnvironmentFile=. Keep it chmod 600.
#
# NO SECRETS by design: the AI Assistant is disabled for the public build, so the UF
# Navigator KEY/BASE are intentionally absent. (If you ever re-enable AI here, put KEY/BASE
# in this file — never in git — and gate access behind RC SSO.)

# ---- WHICH DATASET THIS INSTANCE SERVES ------------------------------------------
# These two are the only things that decide it, and until 2026-09-18 NEITHER was in any
# committed deploy file. The one thing selecting the run cohort on the maintainer's
# workstation is `apps/islet/.Rprofile`, which is GITIGNORED (.gitignore:31) and therefore
# does not travel with a clone. A deploy from a clean checkout got the code fallback in
# apps/islet/R/00_00_iecore.R:23 -- `config/islet_default.yml`, the CODEX domain -- whatever
# it had staged. Set both, deliberately, on every host.
#
# ISLET_DOMAIN_CONFIG -- the domain config, resolved relative to the unit's WorkingDirectory
#   (`.../islet-explorer/apps/islet`). The two domains are separate datasets that share five
#   donors and no vocabulary; they are never merged.
#
#     config/run20_default.yml   PhenoCycler run cohort, 20 donors, data root
#                                ../../data/development/typing/app
#     config/islet_default.yml   legacy CODEX cohort, 15 donors, data root ../../data/app_data
#
#   WHAT BREAKS IF IT IS WRONG: every path in the app resolves through
#   ieCore::domain_data_root(), so a wrong value does not error -- it serves the OTHER
#   cohort's cells under this cohort's labels. Downstream of that, a layer artifact records
#   the domain root it was built from, and a card that reads one compares that against the
#   active domain root and refuses rather than draw. Measured 2026-09-18: five of the nine
#   cards carry that check -- card_s1_size_composition, card_g1_grid, card_s3_compartments,
#   card_n1_sections and card_x1_gradient -- and each names its own reason
#   (`artifact_belongs_to_a_different_domain`, `grid_composition_belongs_to_a_different_domain`,
#   `compartment_gradient_domain_mismatch`, `sections_layer_belongs_to_a_different_domain`,
#   `distance_profile_domain_mismatch`). Every artifact under /data/islet_layers carrying a
#   `source_domain_root` on that date records `.../data/development/typing/app`, the run-cohort
#   root. So CODEX plus these layers is five refusing cards, and the refusal is what tells you
#   the pair is mismatched. The remaining layer cards do not check, which is its own gap.
#
#   Whichever you pick, Phase 2 of DEPLOY.md must stage THAT domain's data root. The two
#   settings and the staged tree are one decision, not three.
ISLET_DOMAIN_CONFIG=config/run20_default.yml

# ISLET_LAYERS_DIR -- where the nine pre-aggregated layer artifacts live. Default in code is
#   the absolute path `/data/islet_layers` (ieCore::ie_layers_dir()), which exists on the
#   maintainer's workstation and on no PubApps VM. There is deliberately no search path: a
#   layer root is configuration, not something to discover by walking the filesystem.
#
#   WHAT BREAKS IF IT IS WRONG: nothing errors. ie_layer_state() reports `unavailable` with
#   the reason `layer directory not found: <path>`, and each card renders that named note
#   instead of a figure. A directory that exists but is empty reports `layer directory is
#   empty`, which is the `mkdir -p` case and is treated the same way. So a wrong value looks
#   like "the app works, those panels just have nothing" -- which is why it is set here.
#
#   Measured 2026-09-18: 430 MB over nine directories -- availability, compartments,
#   distance_profiles, grid_composition, islet_summary (143 MB), pln (240 MB), restain
#   (47 MB), sections, trajectory. Stage it with the domain data root in Phase 2.
ISLET_LAYERS_DIR=/pubapps/<project>/islet_layers

# ---- Runtime --------------------------------------------------------------------
# Point reticulate at the conda env's Python (which has the `anndata` package).
RETICULATE_PYTHON=/pubapps/<project>/prod/conda/bin/python

# Scaling backends (these are the app defaults; listed for clarity/overridability).
ISLET_USE_DUCKDB=TRUE
ISLET_USE_MIRAI=TRUE

# AI Assistant OFF for the public deployment (no UF Navigator key exposed).
ISLET_ENABLE_AI=FALSE

# Fail closed on debug modes and suppress sensitive runtime diagnostics.
ISLET_RUNTIME_MODE=production
DEBUG_CREDENTIALS=0
VIEWER_DEBUG=0

# Port RC assigned for the app (reverse-proxied from https://islet-explorer.rc.ufl.edu/).
ISLET_APP_PORT=<APP_PORT>

# Where the app ENUMERATES OME-TIFFs for the Viewer dropdown. The nginx sidecar SERVES
# the bytes (via HTTP Range); this only lets the R process list available <case>.ome.tiff.
LOCAL_IMAGE_ROOT=/pubapps/<project>/islet_ome_tiff

# ---- Viewer backend -------------------------------------------------------------
# "avivator" (default) streams the OME-TIFFs directly via the nginx sidecar.
# "tissuumaps" swaps in the TissUUmaps service (islet-tissuumaps.container) for
# region drawing, GeoJSON import/export and per-cell marker overlays. Requires
# .tmap projects built by scripts/senior/build_tissuumaps_project.py and a
# /tissuumaps/ proxy route from RC. See deploy/DEPLOY.md § "Viewer backend".
ISLET_VIEWER_BACKEND=avivator
# TISSUUMAPS_URL=/tissuumaps                              # same-origin (RC-proxied)
# TISSUUMAPS_PROJECT_DIR=/pubapps/<project>/tissuumaps    # dropdown enumeration only
# TISSUUMAPS_PROJECT_PATH=                                # subdir of the server's slide root, if any
