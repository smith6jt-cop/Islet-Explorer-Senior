# deploy/env.sh.example — copy to deploy/env.sh on the VM and fill in <project>/<APP_PORT>.
# systemd loads this via EnvironmentFile=. Keep it chmod 600.
#
# NO SECRETS by design: the AI Assistant is disabled for the public build, so the UF
# Navigator KEY/BASE are intentionally absent. (If you ever re-enable AI here, put KEY/BASE
# in this file — never in git — and gate access behind RC SSO.)

# Point reticulate at the conda env's Python (which has the `anndata` package).
RETICULATE_PYTHON=/pubapps/<project>/prod/conda/bin/python

# Scaling backends (these are the app defaults; listed for clarity/overridability).
ISLET_USE_DUCKDB=TRUE
ISLET_USE_MIRAI=TRUE

# AI Assistant OFF for the public deployment (no UF Navigator key exposed).
ISLET_ENABLE_AI=FALSE

# Fail closed on debug modes and suppress sensitive runtime diagnostics.
ISLET_RUNTIME_MODE=production
DEBUG_CREDENTIALS=0
VIEWER_DEBUG=0

# Port RC assigned for the app (reverse-proxied from https://islet-explorer.rc.ufl.edu/).
ISLET_APP_PORT=<APP_PORT>

# Where the app ENUMERATES OME-TIFFs for the Viewer dropdown. The nginx sidecar SERVES
# the bytes (via HTTP Range); this only lets the R process list available <case>.ome.tiff.
LOCAL_IMAGE_ROOT=/pubapps/<project>/islet_ome_tiff

# ---- Viewer backend -------------------------------------------------------------
# "avivator" (default) streams the OME-TIFFs directly via the nginx sidecar.
# "tissuumaps" swaps in the TissUUmaps service (islet-tissuumaps.container) for
# region drawing, GeoJSON import/export and per-cell marker overlays. Requires
# .tmap projects built by scripts/senior/build_tissuumaps_project.py and a
# /tissuumaps/ proxy route from RC. See deploy/DEPLOY.md § "Viewer backend".
ISLET_VIEWER_BACKEND=avivator
# TISSUUMAPS_URL=/tissuumaps                              # same-origin (RC-proxied)
# TISSUUMAPS_PROJECT_DIR=/pubapps/<project>/tissuumaps    # dropdown enumeration only
# TISSUUMAPS_PROJECT_PATH=                                # subdir of the server's slide root, if any
