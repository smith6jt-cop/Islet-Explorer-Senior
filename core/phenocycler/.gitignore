# core/phenocycler holds only the PhenoCycler lane's data. The code moved to core/multiplex5000
# on 2026-10-20 (MultiPlex5000 D1); the data stays here until phase H moves it into a release,
# and core/multiplex5000/data is a link to this data/ directory.
#
# Everything else left here by the old layout (build/, the egg-info, the old package's caches
# and setuptools-scm file) is ignored.
/*
!/.gitignore
!/data/

# Phenocycler Analysis inputs and generated content-addressed runs.  The cohort
# manifest may contain protected source paths, so the complete local data root
# stays out of version control.
#
# Descend-then-negate rather than a blanket `/data/`: git does not look inside an
# excluded directory, so a bare `/data/` makes every `!` below unreachable and would
# silently drop the tracked integration inputs. Those are the reproducibility
# record of which donors were paired and how the two label vocabularies were
# reconciled, so they stay in version control.
/data/*
!/data/integration/
/data/integration/*
!/data/integration/xenium_paths.csv
!/data/integration/donor_overrides.csv
!/data/integration/section_overrides.csv
!/data/integration/tissue_condition.csv
!/data/integration/restain_registration_inputs.csv
!/data/integration/vocab_crosswalk.csv
# Declares which (donor, roi, xenium_serial) pairs were imaged on ONE physical
# section. It governs whether cell-to-cell pairing is permitted at all, so it is a
# correctness input, not a local convenience -- it must travel with the repo.
!/data/integration/section_modes.csv
# Hand-recorded by the maintainer and recorded nowhere else: the qptiff carries channel
# names but no <Biomarker> tag, and a serial carries both a Panc and a pLN bundle.
!/data/integration/restain_sections.csv
# Likewise hand-recorded: which QuPath annotation delimits the lymph node on each pLN slide.
# 18 of 19 slides carry explicit pLN_* outlines; 6380 carries one Tissue annotation and no
# pLN_* region at all, and only the maintainer can say that the one Tissue IS the node there.
!/data/integration/pln_node_annotations.csv
